<?xml version="1.0" encoding="utf-8"?>
<!-- GameLayout acomoda la pantalla del juego según la orientación (ver GameLayout.kt);
     los controles y la barra de edición van encima de todo. -->
<com.gbalink.online.GameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_bg"
    android:splitMotionEvents="true">

    <!-- Pantalla del juego (3:2) con los botones superpuestos en las esquinas -->
    <FrameLayout
        android:id="@+id/screenFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000">

        <SurfaceView
            android:id="@+id/gameSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/btnMenu"
            style="@style/CornerButton"
            android:layout_gravity="top|start"
            android:contentDescription="Menú"
            android:text="☰" />

        <FrameLayout
            android:id="@+id/btnChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:contentDescription="Chat">

            <TextView
                style="@style/CornerButton"
                android:text="💬" />

            <TextView
                android:id="@+id/chatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/badge_bg"
                android:minWidth="18dp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Último mensaje recibido, cuando el chat está cerrado -->
        <TextView
            android:id="@+id/chatToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginStart="56dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/toast_bg"
            android:maxLines="3"
            android:ellipsize="end"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/waitingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/toast_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Panel de chat: semitransparente, encima del juego y lejos de los controles -->
        <LinearLayout
            android:id="@+id/chatPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/chat_panel_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/chatTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chatClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:contentDescription="Cerrar chat"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:paddingHorizontal="12dp">

                <LinearLayout
                    android:id="@+id/chatList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="6dp">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Escribí un mensaje…"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:inputType="textShortMessage|textCapSentences"
                    android:maxLength="300"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/chatSend"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/send_bg"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Enviar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sala en línea: código y estado antes de empezar -->
        <LinearLayout
            android:id="@+id/lobbyPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/lobby_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/lobbyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/lobbyCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:textColor="@color/accent"
                android:textSize="48sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lobbyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lobbyShare"
                    style="@style/LobbyButton"
                    android:text="Compartir código"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lobbyCancel"
                    style="@style/LobbyButton"
                    android:layout_marginStart="10dp"
                    android:text="Cancelar" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/status_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:textColor="#AAFFFFFF"
        android:textSize="12sp" />

    <com.gbalink.online.ControlsView
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra del modo "Mover controles" -->
    <LinearLayout
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/toast_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Arrastrá los controles adonde quieras.\nTocá uno para cambiarle el tamaño."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editSmaller"
                style="@style/EditButton"
                android:text="Tamaño −" />

            <TextView
                android:id="@+id/editBigger"
                style="@style/EditButton"
                android:text="Tamaño +" />

            <TextView
                android:id="@+id/editFainter"
                style="@style/EditButton"
                android:text="Más transparente" />

            <TextView
                android:id="@+id/editStronger"
                style="@style/EditButton"
                android:text="Menos transparente" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editReset"
                style="@style/EditButton"
                android:text="Restablecer" />

            <TextView
                android:id="@+id/editDone"
                style="@style/EditButton"
                android:background="@drawable/button_primary"
                android:text="Listo" />
        </LinearLayout>
    </LinearLayout>
</com.gbalink.online.GameLayout>
